        <g class="detector-tracker">
          {
            trackerLayers.map(layer => (
              <g class={`detector-silicon detector-silicon-${layer.direction}`}>
                <path d={detectorPlane(layer.y, 0.055)} />
                <path d={detectorEdge(layer.y, 2)} />
