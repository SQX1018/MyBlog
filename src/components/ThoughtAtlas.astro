        <circle cx="377" cy="267" r="2.5"></circle>
      </g>
      <g class="detector-ticks">
        <path d="M326 51V64M326 412V425M139 238H152M500 238H513"></path>
        <path d="M211 87L217 99M435 377L441 389M173 359L185 353M467 123L479 117"
        ></path>
        <path d="M90 381H118M90 391H108M90 401H118"></path>
      </g>
      <g class="atlas-track-particles" aria-hidden="true" pointer-events="none">
        {
          routes.map(route => (
            <circle
              class="atlas-track-particle"
              data-atlas-particle={route.name}
              data-speed={route.speed}
