<div id="thought-atlas" class="thought-atlas">
  <svg
    class="atlas-geometry"
    viewBox="0 0 640 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      {
        routes.map(route => (
          <path
            data-atlas-route={route.name}
            data-entry={route.entry}
            data-speed={route.speed}
            data-rest-progress={route.restProgress}
            d={`${route.entry}${route.exit}`}
          />
        ))
      }
    </defs>
    <g class="detector-far">
      <g class="detector-stars">
        <circle cx="72" cy="102" r="1.2"></circle>
        <circle cx="116" cy="338" r="1"></circle>
        <circle cx="188" cy="48" r="1.1"></circle>
        <circle cx="250" cy="418" r="1.2"></circle>
        <circle cx="359" cy="30" r="1"></circle>
        <circle cx="434" cy="432" r="1.1"></circle>
        <circle cx="520" cy="62" r="1.2"></circle>
        <circle cx="586" cy="348" r="1"></circle>
        <circle cx="608" cy="172" r="1.1"></circle>
        <circle cx="44" cy="238" r="1"></circle>
      </g>
      <g class="detector-orbits">
        <circle cx="326" cy="238" r="174"></circle>
        <circle cx="326" cy="238" r="126" stroke-dasharray="1 10"></circle>
        <path d="M152 238H500M326 64V412"></path>
        <path d="M203 115L449 361M449 115L203 361" stroke-dasharray="1 14"
        ></path>
      </g>
    </g>

    <g class="detector-mid">
      <g class="detector-static-model">
        <g class="detector-shell">
          <!-- The upper side guards stop early to expose the tracking volume. -->
          <path
            class="detector-panel"
            d="M218 105L314 163L314 190L218 132ZM382 65L478 123L478 177L382 119Z"
          ></path>
          <path d={detectorPlane(105)}></path>
          <path d={detectorEdge(105, 6)}></path>
          <path d="M218 132V184M314 190V218M478 177V246M382 119V160"></path>
          <path d="M218 184L228 190M304 212L314 218M468 240L478 246"></path>
        </g>

        <g class="detector-converter">
          <path d={detectorPlane(163, 0.035)}></path>
