              cy={route.start.y}
              r="3.6"
            />
          ))
        }
      </g>
    </g>
  </svg>
</div>

<script>
  import {
    BoxGeometry,
    BufferGeometry,
    Color,
    DoubleSide,
    EdgesGeometry,
    Float32BufferAttribute,
    Group,
    LineBasicMaterial,
    LineSegments,
    Mesh,
    MeshBasicMaterial,
    OrthographicCamera,
    Scene,
    WebGLRenderer,
  } from "three";

  const MODEL_FIXED_ANGLE = Math.PI / 5;
  const MODEL_RADIANS_PER_SECOND = (Math.PI * 2) / 60;

  function createDetectorController(
    atlas: HTMLElement,
    reduceMotion: MediaQueryList
  ) {
    const canvas = atlas.querySelector<HTMLCanvasElement>(
      ".atlas-model-canvas"
    );
    if (!canvas) return { sync: () => {}, dispose: () => {} };

    let renderer: WebGLRenderer | undefined;
    let scene: Scene | undefined;
    let camera: OrthographicCamera | undefined;
    let model!: Group;
    let resizeObserver: ResizeObserver | undefined;
    let themeObserver: MutationObserver | undefined;
    let frame = 0;
    let lastTime = 0;
    let lastRender = 0;
    let angle = MODEL_FIXED_ANGLE;
    let active = false;
    let disposed = false;
    let rendered = false;
    const themedMaterials: {
      material: MeshBasicMaterial | LineBasicMaterial;
      color: "accent" | "foreground";
    }[] = [];

    const dispose = () => {
      if (disposed) return;
      disposed = true;
      cancelAnimationFrame(frame);
      resizeObserver?.disconnect();
      themeObserver?.disconnect();
      if (scene) {
        const geometries = new Set<BufferGeometry>();
        const materials = new Set<MeshBasicMaterial | LineBasicMaterial>();
        scene.traverse(object => {
          if (object instanceof Mesh || object instanceof LineSegments) {
            geometries.add(object.geometry);
            const objectMaterials = Array.isArray(object.material)
              ? object.material
              : [object.material];
            for (const material of objectMaterials) materials.add(material);
          }
        });
        geometries.forEach(geometry => geometry.dispose());
        materials.forEach(material => material.dispose());
      }
      renderer?.dispose();
      renderer?.forceContextLoss();
      delete atlas.dataset.webgl;
      delete atlas.dataset.modelRotation;
      delete atlas.dataset.modelFrames;
    };

    try {
      renderer = new WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "low-power",
      });
      renderer.setClearColor(0x000000, 0);
      renderer.shadowMap.enabled = false;
      scene = new Scene();
      model = new Group();
      scene.add(model);

      // Off-axis frustum places the model origin exactly at SVG (326, 238).
      camera = new OrthographicCamera(-326, 314, 238, -242, 0.1, 2000);
      camera.position.set(300, 230, 390);
      camera.lookAt(0, 0, 0);

      const surface = (color: "accent" | "foreground", opacity: number) => {
        const material = new MeshBasicMaterial({
          transparent: true,
          opacity,
          depthWrite: false,
          side: DoubleSide,
        });
        themedMaterials.push({ material, color });
        return material;
      };
      const outline = (color: "accent" | "foreground", opacity: number) => {
        const material = new LineBasicMaterial({
          transparent: true,
          opacity,
          depthWrite: false,
        });
        themedMaterials.push({ material, color });
        return material;
      };
      const shellSurface = surface("accent", 0.025);
      const layerSurface = surface("accent", 0.035);
      const crystalSurface = surface("accent", 0.04);
      const shellLine = outline("accent", 0.24);
      const converterLine = outline("accent", 0.46);
      const trackerLine = outline("accent", 0.32);
      const crystalLine = outline("accent", 0.28);
      const stripLine = outline("foreground", 0.22);

      const addBox = (
        parent: Group,
        size: [number, number, number],
        position: [number, number, number],
        surfaceMaterial: MeshBasicMaterial,
        lineMaterial: LineBasicMaterial
      ) => {
        const geometry = new BoxGeometry(...size);
        const mesh = new Mesh(geometry, surfaceMaterial);
        const edges = new LineSegments(
          new EdgesGeometry(geometry),
          lineMaterial
        );
        mesh.position.set(...position);
        edges.position.set(...position);
        parent.add(mesh, edges);
      };

      // Anti-coincidence detector: thin top and shortened, open side guards.
      addBox(model, [190, 5, 112], [0, 110, 0], shellSurface, shellLine);
      addBox(model, [190, 34, 2], [0, 91, -55], shellSurface, shellLine);
      addBox(model, [2, 34, 112], [-94, 91, 0], shellSurface, shellLine);
      addBox(model, [2, 24, 72], [94, 96, -20], shellSurface, shellLine);

      // CsI converter and three double layers of silicon microstrips.
      addBox(model, [178, 4, 102], [0, 61, 0], layerSurface, converterLine);
      const layerYs = [39, 33, 13, 7, -13, -19];
      layerYs.forEach((y, index) => {
        addBox(model, [174, 1.4, 98], [0, y, 0], layerSurface, trackerLine);
        const points: number[] = [];
        for (const offset of [-0.3, -0.1, 0.1, 0.3]) {
          if (index % 2 === 0) {
            points.push(-80, y + 1, offset * 92, 80, y + 1, offset * 92);
          } else {
            points.push(offset * 164, y + 1, -45, offset * 164, y + 1, 45);
          }
        }
        const geometry = new BufferGeometry();
        geometry.setAttribute(
          "position",
          new Float32BufferAttribute(points, 3)
        );
        model.add(new LineSegments(geometry, stripLine));
      });

      // Electromagnetic calorimeter: separated vertical crystals and a base.
      const crystalGeometry = new BoxGeometry(29, 50, 15);
      for (let row = 0; row < 5; row++) {
        for (let column = 0; column < 5; column++) {
          const mesh = new Mesh(crystalGeometry, crystalSurface);
          const edges = new LineSegments(
            new EdgesGeometry(crystalGeometry),
            crystalLine
          );
          const position: [number, number, number] = [
            (column - 2) * 35,
            -70,
            (row - 2) * 20,
          ];
          mesh.position.set(...position);
          edges.position.set(...position);
          model.add(mesh, edges);
        }
      }
      addBox(model, [190, 6, 112], [0, -101, 0], shellSurface, shellLine);

      const updateColors = () => {
        const styles = getComputedStyle(atlas);
        const colors = {
          accent: styles.getPropertyValue("--accent").trim(),
          foreground: styles.getPropertyValue("--foreground").trim(),
        };
        for (const entry of themedMaterials) {
          entry.material.color = new Color(colors[entry.color]);
        }
      };
      const render = () => {
        if (!renderer || !scene || !camera || !model || disposed) return;
        model.rotation.y = angle;
        renderer.render(scene, camera);
        atlas.dataset.modelRotation = angle.toFixed(6);
        atlas.dataset.modelFrames = String(
          Number(atlas.dataset.modelFrames ?? 0) + 1
        );
        if (!rendered) {
          rendered = true;
          atlas.dataset.webgl = "ready";
        }
      };
      const resize = () => {
        if (!renderer || disposed) return;
        const bounds = canvas.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
        renderer.setSize(bounds.width, bounds.height, false);
        atlas.dataset.modelPixelRatio = String(renderer.getPixelRatio());
        render();
      };
      const animate = (time: number) => {
        frame = 0;
        if (disposed || !active || reduceMotion.matches || document.hidden)
          return;
        if (lastTime) {
          const delta = Math.max(0, (time - lastTime) / 1000);
          angle = (angle + delta * MODEL_RADIANS_PER_SECOND) % (Math.PI * 2);
        }
        lastTime = time;
        if (time - lastRender >= 1000 / 30) {
          render();
          lastRender = time;
        }
        frame = requestAnimationFrame(animate);
      };
      const sync = (shouldRun: boolean) => {
        active = shouldRun;
        cancelAnimationFrame(frame);
        frame = 0;
        lastTime = 0;
        lastRender = 0;
        if (disposed || !rendered) return;
        if (reduceMotion.matches) {
          angle = MODEL_FIXED_ANGLE;
          render();
        } else if (active) {
          frame = requestAnimationFrame(animate);
        }
      };

      updateColors();
      resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(canvas);
      themeObserver = new MutationObserver(() => {
        updateColors();
        if (!active || reduceMotion.matches) render();
      });
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      resize();
      render();
      atlas.dataset.modelRotationPeriod = "60";
      return { sync, dispose };
    } catch {
      atlas.dataset.webgl = "fallback";
      dispose();
      atlas.dataset.webgl = "fallback";
      return { sync: () => {}, dispose };
    }
  }

  let stopPreviousAtlas = () => {};

  function setupThoughtAtlas() {
    stopPreviousAtlas();

    const atlas = document.querySelector<HTMLElement>("#thought-atlas");
    if (!atlas) return;
    atlas.dataset.ready = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const detector = createDetectorController(atlas, reduceMotion);
    const particles = Array.from(
      atlas.querySelectorAll<SVGPathElement>("[data-atlas-route]")
    ).flatMap(path => {
      const name = path.dataset.atlasRoute;
      const particle = atlas.querySelector<SVGCircleElement>(
        `[data-atlas-particle="${name}"]`
      );
      const length = path.getTotalLength();
      const speed = Number(path.dataset.speed);
      if (!particle || !length || !speed) return [];

      // Both the visible segments and the motion route use the same geometry.
      const entry = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "path"
      );
      entry.setAttribute("d", path.dataset.entry ?? "");
      path.dataset.vertexDistance = String(entry.getTotalLength());
      path.dataset.totalLength = String(length);

      return [
        {
          path,
          particle,
          length,
          speed,
          distance: 0,
          restProgress: Number(path.dataset.restProgress),
        },
      ];
    });
    let frame = 0;
    let lastTime = 0;
    let disposed = false;
    const bounds = atlas.getBoundingClientRect();
    let visible = bounds.bottom > 0 && bounds.top < window.innerHeight;

    const drawParticle = (state: (typeof particles)[number], still = false) => {
      const point = state.path.getPointAtLength(state.distance);
      const fadeDistance = Math.min(state.speed * 0.18, state.length * 0.08);
      const alpha = still
        ? 0.95
        : Math.min(
            1,
            state.distance / fadeDistance,
            (state.length - state.distance) / fadeDistance
          ) * 0.95;
      state.particle.setAttribute("cx", String(point.x));
      state.particle.setAttribute("cy", String(point.y));
      state.particle.setAttribute("opacity", String(alpha));
      state.particle.dataset.distance = String(state.distance);
    };

    const resetPointer = () => {
      atlas.style.setProperty("--pointer-x", "0");
      atlas.style.setProperty("--pointer-y", "0");
    };

    const animate = (time: number) => {
      frame = 0;
      if (disposed || !atlas.isConnected) return;
      if (lastTime) {
        const delta = Math.max(0, (time - lastTime) / 1000);
        for (const state of particles) {
          state.distance =
            (state.distance + state.speed * delta) % state.length;
          drawParticle(state);
        }
      }
      lastTime = time;
      frame = requestAnimationFrame(animate);
    };

    const updateMotion = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      lastTime = 0;
      if (disposed) return;

      if (reduceMotion.matches) {
        resetPointer();
        atlas.dataset.motion = "reduced";
        for (const state of particles) {
          state.distance = state.restProgress * state.length;
          drawParticle(state, true);
        }
      } else {
        const active = visible && !document.hidden;
        atlas.dataset.motion = active ? "active" : "paused";
        if (active && particles.length) {
          lastTime = performance.now();
          frame = requestAnimationFrame(animate);
        }
      }
      detector.sync(visible && !document.hidden);
    };

    const onPointerMove = (event: PointerEvent) => {
      if (reduceMotion.matches || event.pointerType === "touch") return;
      const bounds = atlas.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 2;
      const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 2;
      atlas.style.setProperty("--pointer-x", x.toFixed(3));
      atlas.style.setProperty("--pointer-y", y.toFixed(3));
    };
    const intersectionObserver = new IntersectionObserver(([entry]) => {
      if (disposed || visible === entry.isIntersecting) return;
      visible = entry.isIntersecting;
      updateMotion();
    });
    intersectionObserver.observe(atlas);
    atlas.addEventListener("pointermove", onPointerMove);
    atlas.addEventListener("pointerleave", resetPointer);
    reduceMotion.addEventListener("change", updateMotion);
    document.addEventListener("visibilitychange", updateMotion);

    for (const state of particles) drawParticle(state);
    updateMotion();

    stopPreviousAtlas = () => {
      disposed = true;
      detector.dispose();
      cancelAnimationFrame(frame);
      intersectionObserver.disconnect();
      atlas.removeEventListener("pointermove", onPointerMove);
      atlas.removeEventListener("pointerleave", resetPointer);
      reduceMotion.removeEventListener("change", updateMotion);
      document.removeEventListener("visibilitychange", updateMotion);
      atlas.dataset.motion = "paused";
      delete atlas.dataset.ready;
    };
  }

  setupThoughtAtlas();
  document.addEventListener("astro:after-swap", setupThoughtAtlas);
  document.addEventListener("astro:before-swap", () => stopPreviousAtlas());
  window.addEventListener("pageshow", event => {
    if (event.persisted) setupThoughtAtlas();
  });
</script>

<style>
  .atlas-track-particles {
    color: var(--accent);
    pointer-events: none;
  }

  .atlas-track-particle {
    fill: currentColor;
    stroke: none;
    filter: drop-shadow(0 0 3px currentColor);
  }

  .atlas-track-particle[data-atlas-particle="right"] {
    color: #737373;
  }

  :global([data-theme="dark"])
    .atlas-track-particle[data-atlas-particle="right"] {
    color: #b3b3b3;
  }

  @media (prefers-reduced-motion: reduce) {
    .detector-far,
    .detector-mid,
    .detector-near,
    .atlas-model-canvas {
      transform: none;
    }
  }
</style>
