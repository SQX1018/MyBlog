type Point = readonly [number, number];

// Natural cubic splines keep tangent and curvature continuous along each route.
// These controls are generated at build time, not in the animation loop.
function smoothRoute(points: readonly Point[], vertexIndex: number) {
  const count = points.length - 1;
  const firstControls = (axis: 0 | 1) => {
    const diagonal = Array<number>(count).fill(4);
    const values = Array.from({ length: count }, (_, index) =>
      index === 0
        ? points[0][axis] + 2 * points[1][axis]
        : index === count - 1
          ? 8 * points[index][axis] + points[index + 1][axis]
          : 4 * points[index][axis] + 2 * points[index + 1][axis]
    );
    diagonal[0] = 2;
    diagonal[count - 1] = 7;
    for (let index = 1; index < count; index++) {
      const factor = (index === count - 1 ? 2 : 1) / diagonal[index - 1];
      diagonal[index] -= factor;
      values[index] -= factor * values[index - 1];
    }
    values[count - 1] /= diagonal[count - 1];
    for (let index = count - 2; index >= 0; index--) {
      values[index] = (values[index] - values[index + 1]) / diagonal[index];
    }
    return values;
  };
  const x = firstControls(0);
  const y = firstControls(1);
  const segments = Array.from({ length: count }, (_, index) => {
    const end = points[index + 1];
    const second =
      index === count - 1
        ? [(end[0] + x[index]) / 2, (end[1] + y[index]) / 2]
        : [2 * end[0] - x[index + 1], 2 * end[1] - y[index + 1]];
    const controls = [x[index], y[index], ...second, ...end]
      .map(value => Number(value.toFixed(3)))
      .join(" ");
    return `C${controls}`;
  });
  return {
    entry: `M${points[0].join(" ")}${segments.slice(0, vertexIndex).join("")}`,
    exit: segments.slice(vertexIndex).join(""),
  };
}

const { entry: leftEntry, exit: leftExit } = smoothRoute(
  [
    [54, 34],
    [164, 103],
    [290, 184],
    [326, 238],
    [303, 292],
    [262, 355],
    [295, 382],
    [340, 365],
  ],
  3
);
const { entry: rightEntry, exit: rightExit } = smoothRoute(
  [
    [590, 88],
    [484, 126],
    [364, 192],
    [326, 238],
    [372, 290],
    [399, 345],
    [360, 383],
    [319, 376],
    [298, 342],
    [319, 305],
  ],
  3
);
const routes = [
  {
    name: "left",
    entry: leftEntry,
    exit: leftExit,
    speed: 80,
    start: { x: 54, y: 34 },
    restProgress: 0.25,
  },
  {
    name: "right",
    entry: rightEntry,
    exit: rightExit,
    speed: 55,
    start: { x: 590, y: 88 },
    restProgress: 0.65,
  },
];

// An artistic isometric cutaway of VLAST-P, not an engineering drawing.
const detectorOrigin: Point = [218, 105];
const detectorU: Point = [164, -40];
const detectorV: Point = [96, 58];
const detectorPoint = (y: number, s: number, t: number): Point => [
  detectorOrigin[0] + detectorU[0] * s + detectorV[0] * t,
  y + detectorU[1] * s + detectorV[1] * t,
];
const pathFrom = (points: readonly Point[], close = false) =>
  `${points.map((point, index) => `${index ? "L" : "M"}${point.join(" ")}`).join("")}${close ? "Z" : ""}`;
const detectorPlane = (y: number, inset = 0) =>
  pathFrom(
    [
      detectorPoint(y, inset, inset),
      detectorPoint(y, 1 - inset, inset),
      detectorPoint(y, 1 - inset, 1 - inset),
      detectorPoint(y, inset, 1 - inset),
    ],
    true
  );
const detectorEdge = (y: number, thickness = 3) => {
  const frontLeft = detectorPoint(y, 0, 1);
  const frontRight = detectorPoint(y, 1, 1);
  const backRight = detectorPoint(y, 1, 0);
  return (
    pathFrom([
      [frontLeft[0], frontLeft[1] + thickness],
      frontLeft,
      frontRight,
      [frontRight[0], frontRight[1] + thickness],
    ]) +
    pathFrom([frontRight, backRight, [backRight[0], backRight[1] + thickness]])
  );
};
const measurementLines = (y: number, direction: "x" | "y") =>
  [0.18, 0.39, 0.61, 0.82].map(position =>
    pathFrom(
      direction === "x"
        ? [detectorPoint(y, 0.07, position), detectorPoint(y, 0.93, position)]
        : [detectorPoint(y, position, 0.07), detectorPoint(y, position, 0.93)]
    )
  );
const trackerLayers = [
  { y: 184, direction: "x" as const },
  { y: 190, direction: "y" as const },
  { y: 208, direction: "x" as const },
  { y: 214, direction: "y" as const },
  { y: 232, direction: "x" as const },
  { y: 238, direction: "y" as const },
];
const crystals = Array.from({ length: 5 }, (_, row) =>
  Array.from({ length: 5 }, (_, column) => ({ row, column }))
)
  .flat()
  .sort((a, b) => a.row + a.column - (b.row + b.column))
  .map(({ row, column }) => {
    const gap = 0.018;
    const s0 = column / 5 + gap;
    const s1 = (column + 1) / 5 - gap;
    const t0 = row / 5 + gap;
    const t1 = (row + 1) / 5 - gap;
    const a = detectorPoint(272, s0, t0);
    const b = detectorPoint(272, s1, t0);
    const c = detectorPoint(272, s1, t1);
    const d = detectorPoint(272, s0, t1);
    const down = ([x, y]: Point): Point => [x, y + 36];
    return {
      top: pathFrom([a, b, c, d], true),
      right: pathFrom([b, c, down(c), down(b)], true),
      front: pathFrom([d, c, down(c), down(d)], true),
    };
  });
