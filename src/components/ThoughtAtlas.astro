            ))
          }
        </g>

        <g class="detector-calorimeter">
          <path class="detector-base" d={detectorPlane(314, 0.015)}></path>
          <path class="detector-base" d={detectorEdge(314, 7)}></path>
          {
            crystals.map(crystal => (
              <g class="detector-crystal">
                <path class="detector-crystal-right" d={crystal.right} />
                <path class="detector-crystal-front" d={crystal.front} />
                <path class="detector-crystal-top" d={crystal.top} />
              </g>
            ))
          }
        </g>
      </g>
      <g class="detector-tracks-secondary">
        <path
          d="M326 238C383 202 428 197 463 214C498 231 499 269 468 281C437 293 410 269 422 247"
        ></path>
        <path d="M326 238C368 275 403 319 446 344C482 365 526 357 552 326"
        ></path>
      </g>
    </g>
  </svg>

  <canvas class="atlas-model-canvas" aria-hidden="true"></canvas>

  <svg
    class="atlas-geometry atlas-foreground"
    viewBox="0 0 640 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <g class="detector-near">
      <g class="detector-vertex">
        <circle cx="326" cy="238" r="43"></circle>
        <circle cx="326" cy="238" r="25" stroke-dasharray="2 5"></circle>
        <path d="M326 184V207M326 269V292M272 238H295M357 238H380"></path>
        <circle cx="326" cy="238" r="3" class="detector-point-fill"></circle>
      </g>
      <g class="detector-tracks-secondary">
        <path d={`M326 238${leftExit}`}></path>
      </g>
      <g class="detector-tracks-primary">
