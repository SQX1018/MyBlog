---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section
      id="hero"
      class="border-border border-b pt-10 pb-12 sm:pt-16 sm:pb-14"
    >
      <div class="text-accent flex items-center justify-between gap-4 text-sm">
        <span class="flex items-center gap-2 tracking-widest">
          <span class="bg-accent size-1.5 rounded-full" aria-hidden="true"
          ></span>
          个人博客
        </span>
        <a
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="flex items-center gap-2 underline-offset-4 hover:underline"
          aria-label={t.home.rssFeed}
          title={t.home.rssFeed}
        >
          <IconRss width={16} height={16} aria-hidden="true" />
          <span>{t.home.rssFeed}</span>
        </a>
      </div>
      <h1
        class="font-editorial mt-7 mb-6 text-4xl leading-snug font-semibold tracking-wide sm:text-6xl"
      >
        你好，欢迎来到<br />
        <span class="text-accent">我的博客。</span>
      </h1>
      <p class="text-lg">我是{site.author}。</p>
      <p class="text-muted-foreground mt-3 max-w-2xl leading-loose">
        {site.description}
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "about")}
        class="text-accent mt-6 gap-2 text-sm underline-offset-4 hover:underline"
      >
        关于我
        <IconArrowRight class="size-4" aria-hidden="true" />
      </LinkButton>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-accent font-editorial flex items-center gap-3 text-2xl font-semibold tracking-wide before:h-5 before:w-0.5 before:bg-current">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-accent font-editorial flex items-center gap-3 text-2xl font-semibold tracking-wide before:h-5 before:w-0.5 before:bg-current">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="border-accent/40 text-accent hover:bg-accent hover:text-accent-foreground gap-2 rounded-full border px-6 py-2.5 text-sm transition-colors"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
