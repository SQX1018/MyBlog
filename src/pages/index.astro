---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ThoughtAtlas from "@/components/ThoughtAtlas.astro";
import HeroParticles from "@/components/HeroParticles.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="home-hero">
      <HeroParticles />
      <div class="hero-copy">
        <h1 class="hero-title">测量宇宙<br /><span>思考世界</span></h1>
        <p class="hero-description">
          我来自USTC，粒子物理与原子核物理专业，目前正在撰写毕业论文。
        </p>
        <div class="hero-actions">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="hero-primary"
          >
            开始阅读
            <IconArrowRight class="size-4" aria-hidden="true" />
          </LinkButton>
          <a
            href={getAssetPath("rss.xml")}
            data-astro-reload
            class="hero-rss"
            aria-label={t.home.rssFeed}
            title={t.home.rssFeed}
          >
            <IconRss width={17} height={17} aria-hidden="true" />
          </a>
        </div>
        {
          socials.length > 0 && (
            <div class="hero-socials flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
      <ThoughtAtlas />
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="home-section">
          <div class="section-heading">
            <h2>{t.home.featured}</h2>
            <span>SELECTED SIGNALS</span>
          </div>
          <ul class="home-post-list">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="home-section">
          <div class="section-heading">
            <h2>{t.home.recentPosts}</h2>
            <span>LATEST OBSERVATIONS</span>
          </div>
          <ul class="home-post-list">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length === 0 && (
        <p class="text-muted-foreground pt-12 text-center leading-loose">
          {t.home.noPosts}
        </p>
      )
    }

    <div class="my-10 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="all-posts-link"
      >
        {t.home.allPosts}
        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
