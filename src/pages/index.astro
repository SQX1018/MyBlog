---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ThoughtAtlas from "@/components/ThoughtAtlas.astro";
import HeroParticles from "@/components/HeroParticles.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const titleLines = ["Measurement", "& Thought"];
---

<Layout>
  <link
    slot="head"
    rel="preload"
    href={getAssetPath("fonts/Allura-Regular.woff2")}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="home-hero">
      <HeroParticles />
      <div class="hero-copy">
        <h1
          class="hero-title"
          lang="en"
          aria-label={titleLines.join(" ")}
          data-hero-title
          data-state="waiting"
        >
          {
            titleLines.map((line, index) => (
              <span
                class:list={[
                  "hero-title-line",
                  { "hero-title-line--accent": index === 1 },
                ]}
              >
                <span class="hero-title-main">{line}</span>
                <span class="hero-title-trail" aria-hidden="true">
                  {line}
                </span>
                <span
                  class="hero-title-trail hero-title-trail--two"
                  aria-hidden="true"
                >
                  {line}
                </span>
                <span
                  class="hero-title-trail hero-title-trail--three"
                  aria-hidden="true"
                >
                  {line}
                </span>
              </span>
            ))
          }
        </h1>
        <div class="hero-description">
          <p class="hero-identity">我来自 USTC，粒子物理与原子核物理专业。</p>
          <p>记录毕业论文进展、文献阅读，以及对 AI 工具与世界的思考。</p>
        </div>
        <div class="hero-actions">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="hero-primary"
          >
            开始阅读
            <IconArrowRight class="size-4" aria-hidden="true" />
          </LinkButton>
          <a
            href={getAssetPath("rss.xml")}
            data-astro-reload
            class="hero-rss"
            aria-label={t.home.rssFeed}
            title={t.home.rssFeed}
          >
            <IconRss width={17} height={17} aria-hidden="true" />
          </a>
        </div>
        {
          socials.length > 0 && (
            <div class="hero-socials flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
      <ThoughtAtlas />
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="home-section">
          <div class="section-heading">
            <h2>{t.home.featured}</h2>
            <span>SELECTED SIGNALS</span>
          </div>
          <ul class="home-post-list">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="home-section">
          <div class="section-heading">
            <h2>{t.home.recentPosts}</h2>
            <span>LATEST OBSERVATIONS</span>
          </div>
          <ul class="home-post-list">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length === 0 && (
        <p class="text-muted-foreground pt-12 text-center leading-loose">
          {t.home.noPosts}
        </p>
      )
    }

    <div class="my-10 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="all-posts-link"
      >
        {t.home.allPosts}
        <IconArrowRight class="size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  let stopTitleAnimation = () => {};

  function setupHomeTitle() {
    stopTitleAnimation();

    const title = document.querySelector<HTMLElement>("[data-hero-title]");
    if (!title) return;

    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    let cancelled = false;
    let fontTimer = 0;

    const showStaticTitle = () => {
      title.dataset.state = "static";
    };
    const onMotionChange = () => {
      if (motionQuery.matches) showStaticTitle();
    };

    if (motionQuery.matches) {
      showStaticTitle();
      return;
    }

    title.dataset.state = "waiting";
    motionQuery.addEventListener("change", onMotionChange);

    const maxFontWait = new Promise<void>(resolve => {
      fontTimer = window.setTimeout(resolve, 300);
    });
    const fontReady = document.fonts
      .load('400 1em "Allura"', title.getAttribute("aria-label") ?? "")
      .catch(() => undefined);

    Promise.race([fontReady, maxFontWait]).then(() => {
      window.clearTimeout(fontTimer);
      if (cancelled || !title.isConnected) return;
      title.dataset.state = motionQuery.matches ? "static" : "ready";
    });

    stopTitleAnimation = () => {
      cancelled = true;
      window.clearTimeout(fontTimer);
      motionQuery.removeEventListener("change", onMotionChange);
    };
  }

  document.addEventListener("astro:page-load", () => {
    setupHomeTitle();

    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });

  document.addEventListener("astro:before-swap", () => stopTitleAnimation());
  window.addEventListener("pageshow", event => {
    if (event.persisted) setupHomeTitle();
  });
</script>
